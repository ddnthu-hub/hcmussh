rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // admission_scores: Public read access for applicants, students, and counselors
    match /admission_scores/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User score distribution for candidate aggregate analytics
    match /user_score_distribution/{docId} {
      // Anonymous users may read the aggregate records after signing in.
      // Records contain no personal information and are filtered to REAL scores in code.
      allow read: if request.auth != null;
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.userAdmissionScore is number
                        && request.resource.data.userAdmissionScore >= 0
                        && request.resource.data.userAdmissionScore <= 100
                        && request.resource.data.year is number
                        && request.resource.data.scoreType == 'real'
                        && request.resource.data.isReal == true
                        && request.resource.data.approved == false);
      allow update, delete: if isAdmin();
    }

    match /user_messages/{messageId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'unanswered';
        allow read: if request.auth != null
            && (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isAdmin()
              || (request.auth != null
              && resource.data.userId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'answerReadAt']));
        allow delete: if isAdmin();
    }

    // Admin accounts are authenticated with Firebase email/password. Custom
    // admin claims remain supported for deployments that configure them.
    function isAdmin() {
      return request.auth.token.admin == true
        || request.auth.token.email in [
          'vovanthu25122000@gmail.com',
          'tuyensinh.ussh@vnuhcm.edu.vn',
          'truyenthong.ussh@vnuhcm.edu.vn'
        ];
    }

    // Optional prediction logs and analytics
    match /prediction_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /page_views/{viewId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Catalog items
    match /catalogs/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /catalog_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin members and audit logs
    match /admins/{memberId} {
      allow read, write: if request.auth != null;
    }
    match /admin_members/{memberId} {
      allow read, write: if request.auth != null;
    }

    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
