rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdminMember(member) {
      return member != null
        && member.status == 'active'
        && member.role in ['superadmin', 'super_admin', 'admin', 'editor'];
    }

    function activeAdminMemberForCurrentUser() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && isActiveAdminMember(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
      );
    }

    function currentAdminRole() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
      );
    }

    // The current deployment identifies the single Super Admin by the existing
    // account email. Custom admin claims remain supported for staff access.
    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.email == 'vovanthu25122000@gmail.com'
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['superadmin', 'super_admin']
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active'
          )
        );
    }

    function isStaff() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.email in [
            'vovanthu25122000@gmail.com',
            'tuyensinh.ussh@vnuhcm.edu.vn',
            'truyenthong.ussh@vnuhcm.edu.vn'
          ]
          || activeAdminMemberForCurrentUser()
        );
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.email in [
            'vovanthu25122000@gmail.com',
            'tuyensinh.ussh@vnuhcm.edu.vn'
          ]
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'super_admin']
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active'
          )
        );
    }

    function isSuperAdminRole(role) {
      return role == 'superadmin' || role == 'super_admin';
    }

    function isActiveAdminForUserMessages() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['superadmin', 'super_admin', 'admin', 'editor']
      );
    }

    // admission_scores: Public read access for applicants, students, and counselors
    match /admission_scores/{scoreId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // User score distribution for candidate aggregate analytics
    match /user_score_distribution/{docId} {
      // Anonymous users may read the aggregate records after signing in.
      // Records contain no personal information and are filtered to REAL scores in code.
      allow read: if request.auth != null;
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.userAdmissionScore is number
                        && request.resource.data.userAdmissionScore >= 0
                        && request.resource.data.userAdmissionScore <= 100
                        && request.resource.data.year is number
                        && request.resource.data.scoreType == 'real'
                        && request.resource.data.isReal == true
                        && request.resource.data.approved == false);
      allow update, delete: if isAdmin();
    }

    match /user_messages/{messageId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'unanswered';
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isActiveAdminForUserMessages());
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'answerReadAt']))
        || isActiveAdminForUserMessages()
      );
      allow delete: if isAdmin();
    }

    // Admin accounts are authenticated with Firebase email/password. Custom
    // admin claims remain supported for deployments that configure them.
    // Optional prediction logs and analytics
    match /prediction_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /page_views/{viewId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Catalog items
    match /catalogs/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /catalog_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin members and audit logs
    match /admins/{memberId} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSuperAdmin()
                    && request.resource.data.role in ['admin', 'editor'];
      allow update: if isSuperAdmin()
                    && (
                      (!isSuperAdminRole(resource.data.role)
                        && request.resource.data.role in ['admin', 'editor'])
                      || (isSuperAdminRole(resource.data.role)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.status == 'active')
                    );
      allow delete: if isSuperAdmin() && !isSuperAdminRole(resource.data.role);
    }
    match /admin_members/{memberId} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSuperAdmin()
                    && request.resource.data.role in ['admin', 'editor'];
      allow update: if isSuperAdmin()
                    && !isSuperAdminRole(resource.data.role)
                    && request.resource.data.role in ['admin', 'editor'];
      allow delete: if isSuperAdmin() && !isSuperAdminRole(resource.data.role);
    }

    match /audit_logs/{logId} {
      allow read, write: if isStaff();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
